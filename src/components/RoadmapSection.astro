---
// ロードマップ (本体 SPEC.md「将来的な拡張方針」より)。
import RoadmapCard from "./RoadmapCard.astro";

const roadmap = [
  {
    version: "MVP–v0.2",
    status: "実装済み",
    items: [
      "1on1 / 2on2 の自動戦闘",
      "複数ユニット編成",
      "戦闘ログ・発動統計",
      "リプレイ保存",
    ],
  },
  {
    version: "v0.3",
    status: "実装済み",
    items: [
      "障害物・射線判定",
      "簡易経路探索",
      "keep_distance 行動",
      "条件式 or / not / compare",
    ],
  },
  {
    version: "v0.4",
    status: "実装済み",
    items: [
      "軽戦車・重戦車・偵察ドローン・ミサイル車両",
      "cannon / machine_gun / missile",
      "役割分担のある部隊戦",
    ],
  },
  {
    version: "v0.5",
    status: "実装済み",
    items: [
      "簡易プログラム言語",
      "行動ルール ⇄ AST/JSON 相互変換",
      "プレイヤー向け構文リファレンス",
    ],
  },
  {
    // 戦闘体験の刷新 epic。v0.2–v1.0 の線とは別トラックなので版番号を付けない。
    version: "戦闘刷新",
    status: "実装済み",
    items: [
      "支援効果・攻撃バリエーション",
      "プロジェクタイル / 地上・航空レイヤー",
      "タクティカル HUD とユニットインスペクタ",
    ],
  },
  {
    version: "v0.6",
    status: "一部実装済み",
    items: [
      "行動プリセット3種 (牽制 / 回り込み / 護衛)",
      "対空スカウト・航空機と対空迎撃ステージ",
      "ルール評価トレースなど観測・デバッグ体験の強化 (進行中)",
      "編成予算のキャンペーン拡張 (進行中)",
    ],
  },
  {
    version: "v1.0",
    status: "一部実装済み",
    items: [
      "ひとり用キャンペーン (チュートリアルを兼ねる本編16課題 + クリア後のリミックス2課題)",
      "非同期対戦・ランキング",
      "リプレイの保存・書き出し/読み込みと、マッチ ID 指定での閲覧",
      "プレイヤープロフィール (表示名・アバター色・累積統計)",
      "ゲームバランスの調整・磨き込み (継続中)",
    ],
  },
  {
    // web 版とは別のネイティブ描画クライアント。v0.2–v1.0 の線とは別トラック。
    // 未リリースのため、ダウンロードリンクや公開時期は書かない。
    version: "ネイティブ版",
    status: "リリース準備中",
    items: [
      "デスクトップ向けクライアント (web 版とは別トラック)",
      "キャンペーン・フリープレイ・ルールエディタ・敗因分析などを単独で利用可能",
      "対応予定: Windows x64 / macOS (Apple Silicon)",
    ],
  },
];
---

<section id="roadmap" data-animate class="scroll-mt-20">
  <p class="eyebrow">roadmap</p>
  <h2 class="mt-3 text-2xl font-bold sm:text-3xl">到達点とロードマップ</h2>
  <p class="mt-4 max-w-2xl text-slate-300">
    1on1
    の基本形から、複数ユニット戦、障害物、ユニット・武器種、簡易プログラム言語、
    キャンペーン
    （チュートリアル兼用）、非同期対戦、プレイヤープロフィールまで実装が完了。
    現在は正式リリースに向けたバランス調整を磨き込む段階に入っています。
    デスクトップ向けのネイティブ版もリリース準備中です。
  </p>
  <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      roadmap.map((r) => (
        <RoadmapCard version={r.version} status={r.status} items={r.items} />
      ))
    }
  </ol>
</section>
