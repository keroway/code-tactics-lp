---
// ゲームの中身ショーケース。実画面キャプチャで「ルールエディタ」「戦闘ログ」
// 「プログラムエディタ」「複数ユニット戦」を提示する。
import { Image } from "astro:assets";
import ruleEditorImg from "../assets/game-rule-editor.png";
import battleLogImg from "../assets/game-battle-log.png";
import programEditorImg from "../assets/game-program-editor.png";
import multiUnitBattleImg from "../assets/game-multi-unit-battle.png";
---

<section id="how-it-works" data-animate class="scroll-mt-20">
  <p class="eyebrow">how it works</p>
  <h2 class="mt-3 text-2xl font-bold sm:text-3xl">
    ルールを組み、リプレイとログで読み解く。
  </h2>
  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <!-- ルールエディタ (実画面) -->
    <figure
      aria-label="ルールエディタの実画面。TankA の行動ルールを優先順に並べた一覧：#1 敵が射程内かつ武器使用可なら攻撃、#2 敵を発見したら近づく、#3 常に停止"
      class="overflow-hidden rounded-lg border border-slate-800 bg-slate-900/60"
    >
      <figcaption
        class="flex items-center gap-2 border-b border-slate-800 px-4 py-2 font-mono text-xs text-slate-400"
      >
        <span class="size-2.5 rounded-full bg-rose-500/70" aria-hidden="true"
        ></span>
        <span class="size-2.5 rounded-full bg-amber-500/70" aria-hidden="true"
        ></span>
        <span class="size-2.5 rounded-full bg-emerald-500/70" aria-hidden="true"
        ></span>
        <span class="ml-2">rule editor — player-tank</span>
      </figcaption>
      <Image
        src={ruleEditorImg}
        alt="code-tactics ルールエディタの画面。優先順に並んだ 3 件のルール：#1 敵が射程内かつ武器使用可 → 攻撃、#2 敵を発見 → 近づく、#3 常に → 停止"
        class="w-full object-cover"
        loading="lazy"
      />
    </figure>

    <!-- 戦闘ログ (実画面 + 擬似ストリーム演出) -->
    <div class="flex flex-col gap-3">
      <figure
        aria-label="戦闘ログの実画面。各 tick でどのルールが評価され発動したかの時系列記録"
        class="overflow-hidden rounded-lg border border-slate-800 bg-slate-900/60"
      >
        <figcaption
          class="flex items-center gap-2 border-b border-slate-800 px-4 py-2 font-mono text-xs text-slate-400"
        >
          <span class="size-2.5 rounded-full bg-rose-500/70" aria-hidden="true"
          ></span>
          <span class="size-2.5 rounded-full bg-amber-500/70" aria-hidden="true"
          ></span>
          <span
            class="size-2.5 rounded-full bg-emerald-500/70"
            aria-hidden="true"></span>
          <span class="ml-2">battle log</span>
        </figcaption>
        <Image
          src={battleLogImg}
          alt="code-tactics 戦闘ログの画面。tick 119 で cpu-tank と player-tank が attack-when-ready ルールを評価（不一致）→ approach-detected-enemy ルールを評価（一致）→ 近づく行動を発動した記録"
          class="w-full object-cover"
          loading="lazy"
        />
      </figure>

      <!-- 装飾用の擬似ログストリーム (#B-2)。実情報ではないため aria-hidden 。 -->
      <div
        id="log-stream"
        aria-hidden="true"
        class="overflow-hidden rounded-lg border border-slate-800 bg-slate-950/80 p-3 font-mono text-xs text-slate-400"
      >
        <span class="log-stream-cursor">_</span>
      </div>
    </div>

    <!-- プログラムエディタ (実画面) -->
    <figure
      aria-label="プログラムエディタの実画面。行動ルール UI で組んだ内容をテキストの簡易プログラム言語に変換した表示：attack-when-ready、approach-detected-enemy、stop-otherwise の 3 ルール"
      class="overflow-hidden rounded-lg border border-slate-800 bg-slate-900/60"
    >
      <figcaption
        class="flex items-center gap-2 border-b border-slate-800 px-4 py-2 font-mono text-xs text-slate-400"
      >
        <span class="size-2.5 rounded-full bg-rose-500/70" aria-hidden="true"
        ></span>
        <span class="size-2.5 rounded-full bg-amber-500/70" aria-hidden="true"
        ></span>
        <span class="size-2.5 rounded-full bg-emerald-500/70" aria-hidden="true"
        ></span>
        <span class="ml-2">program — player-tank.ct</span>
      </figcaption>
      <Image
        src={programEditorImg}
        alt='code-tactics プログラムエディタの画面。rule "attack-when-ready" when enemy_in_range and weapon_ready target nearest_enemy do attack など、行動ルールから変換された 3 件のテキストルール'
        class="w-full object-cover"
        loading="lazy"
      />
    </figure>

    <!-- 複数ユニット戦 (実画面) -->
    <figure
      aria-label="複数ユニット戦の実画面。2 対 2 の編成で味方 2 体・敵 2 体がそれぞれ射程円を表示しながら対峙している"
      class="overflow-hidden rounded-lg border border-slate-800 bg-slate-900/60 lg:col-span-2"
    >
      <figcaption
        class="flex items-center gap-2 border-b border-slate-800 px-4 py-2 font-mono text-xs text-slate-400"
      >
        <span class="size-2.5 rounded-full bg-rose-500/70" aria-hidden="true"
        ></span>
        <span class="size-2.5 rounded-full bg-amber-500/70" aria-hidden="true"
        ></span>
        <span class="size-2.5 rounded-full bg-emerald-500/70" aria-hidden="true"
        ></span>
        <span class="ml-2">2on2 — multi-unit battle</span>
      </figcaption>
      <Image
        src={multiUnitBattleImg}
        alt="code-tactics の 2 対 2 複数ユニット戦の画面。味方戦車・味方戦車2 と 敵戦車・敵戦車2 の 4 体が、それぞれの射程円を表示しながら盤面に配置されている"
        class="w-full object-cover"
        loading="lazy"
      />
    </figure>
  </div>
  <p class="mt-4 font-mono text-xs text-slate-500">
    ※
    上記はゲームの実際の画面。現在はプログラムタブや複数ユニット編成、キャンペーンや非同期対戦も追加されている。
  </p>
</section>

<script is:inline>
  // 戦闘ログの擬似ストリーム演出 (#B-2)。IntersectionObserver 可用かつ reduced-motion でない時のみ、
  // 可視の間のみ 1 行ずつログを差し込む。非対応・ JS 無効時は全行を静的表示する。
  (function () {
    const lines = [
      "tick 117  cpu-tank  eval attack-when-ready  -> false",
      "tick 118  cpu-tank  eval approach-detected-enemy -> true",
      "tick 118  cpu-tank  action approach(player-tank)",
      "tick 119  player-tank  eval hp_below(30) -> false",
      "tick 119  player-tank  eval enemy_in_range -> true",
      "tick 119  player-tank  action attack(cpu-tank)",
      "tick 120  cpu-tank  eval weapon_ready -> true",
      "tick 120  cpu-tank  action attack(player-tank)",
    ];
    const container = document.getElementById("log-stream");
    if (!container) return;

    const reduceMotion =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const cursor = container.querySelector(".log-stream-cursor");

    function renderStatic() {
      lines.forEach(function (text) {
        const row = document.createElement("p");
        row.textContent = "> " + text;
        container.insertBefore(row, cursor);
      });
    }

    if (reduceMotion || !("IntersectionObserver" in window)) {
      renderStatic();
      return;
    }

    let index = 0;
    let timer = null;
    let started = false;

    function appendLine() {
      const row = document.createElement("p");
      row.className = "log-stream-line";
      row.textContent = "> " + lines[index % lines.length];
      container.insertBefore(row, cursor);
      // 表示行数を抱えすぎないように古い行を間引く (カーソルは除外)
      while (container.children.length > 7) {
        const first = container.firstElementChild;
        if (first === cursor) break;
        container.removeChild(first);
      }
      requestAnimationFrame(function () {
        row.classList.add("is-visible");
      });
      index += 1;
    }

    function start() {
      if (started) return;
      started = true;
      appendLine();
      timer = window.setInterval(appendLine, 1400);
    }

    function stop() {
      if (!started) return;
      started = false;
      if (timer) window.clearInterval(timer);
      timer = null;
    }

    const io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            start();
          } else {
            stop();
          }
        });
      },
      { threshold: 0.3 },
    );
    io.observe(container);
  })();
</script>
