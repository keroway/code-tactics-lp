---
// ヒーロー (ファーストビュー)。#top はヘッダのロゴからのスクロール先。
import {
  PLAY_URL,
  REPO_URL,
  REPO_IS_PUBLIC,
  EXTERNAL_LINK_ATTRS,
  externalLinkLabel,
  withUtm,
} from "../consts";
import { Image } from "astro:assets";
import { existsSync } from "node:fs";
import gameScreenshot from "../assets/game-screenshot.png";

// プレイ動画 (#95)。WebM を優先し、未対応ブラウザ向けに MP4 も配信する。
// アセットが欠けたビルドでは、404 や空の video 要素を避けるため静止画へフォールバックする。
const base = import.meta.env.BASE_URL;
const publicDir = new URL("../../public/", import.meta.url);
const hasHeroVideo =
  existsSync(new URL("hero-battle.webm", publicDir)) &&
  existsSync(new URL("hero-battle.mp4", publicDir)) &&
  existsSync(new URL("hero-poster.jpg", publicDir));
const withBase = (p: string) => `${base}/${p}`.replace(/\/+/g, "/");
---

<section
  id="top"
  aria-labelledby="hero-heading"
  class="mx-auto flex max-w-5xl flex-col items-start gap-6 px-6 pt-24 pb-16"
>
  <p class="eyebrow">programmable auto-battle</p>
  <h1 id="hero-heading" class="text-4xl font-bold tracking-tight sm:text-6xl">
    自分で組んだ AI で、<br />部隊を戦わせる。
  </h1>
  <p class="max-w-2xl text-lg text-slate-300">
    複数ユニットの AI を行動ルール UI
    またはテキストプログラムで設計し、自動戦闘を観察してログで分析する。
    軽戦車・重戦車・偵察ドローン・ミサイル車両、障害物、キャンペーン、非同期対戦まで広がった、
    観察とデバッグが中核のプログラマブル・オートバトル。
  </p>
  <div class="mt-2 flex flex-wrap gap-4">
    <a
      href={withUtm(PLAY_URL, "hero")}
      class="btn-primary"
      aria-label={externalLinkLabel("今すぐプレイ")}
      {...EXTERNAL_LINK_ATTRS}>今すぐプレイ</a
    >
    {
      REPO_IS_PUBLIC ? (
        <a
          href={REPO_URL}
          class="btn-ghost"
          aria-label={externalLinkLabel("GitHub を見る")}
          {...EXTERNAL_LINK_ATTRS}
        >
          GitHub を見る
        </a>
      ) : (
        <span class="btn-ghost-disabled" aria-disabled="true">
          GitHub（準備中）
        </span>
      )
    }
  </div>

  {
    hasHeroVideo ? (
      <figure
        aria-label="code-tactics のプレイ動画。ルールエディタで設定した AI に従い、複数の戦車が自動で接近・戦闘する様子"
        class="mt-4 w-full overflow-hidden rounded-xl border border-slate-800 shadow-2xl"
      >
        <video
          class="w-full"
          poster={withBase("hero-poster.jpg")}
          width="1280"
          height="800"
          muted
          loop
          playsinline
          controls
          preload="none"
          data-motion-optional
        >
          <source src={withBase("hero-battle.webm")} type="video/webm" />
          <source src={withBase("hero-battle.mp4")} type="video/mp4" />
        </video>
      </figure>
    ) : (
      <figure
        aria-label="code-tactics のゲーム画面。左に行動ルールエディタ、中央に 2 体の戦車が接近する戦場キャンバス、下にリアルタイム戦闘ログ"
        class="mt-4 w-full overflow-hidden rounded-xl border border-slate-800 shadow-2xl"
      >
        <Image
          src={gameScreenshot}
          alt="code-tactics のゲーム全体画面。右パネルの行動ルールエディタで AI ルールを設定し、中央キャンバスで 2 体の戦車（青・赤）が互いの射程に接近した場面"
          class="w-full"
          loading="eager"
        />
      </figure>
    )
  }
</section>

<script is:inline>
  // 通常時だけ、表示領域に入った動画を自動再生する。preload="none" と組み合わせ、
  // ファーストビューで不要な動画転送を避ける。reduce-motion 時は poster のままにし、
  // 利用者が controls の再生ボタンを押した場合のみ再生できるようにする。
  (function () {
    const video = document.querySelector("video[data-motion-optional]");
    if (!video || !(video instanceof HTMLVideoElement)) return;

    const mediaQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (mediaQuery.matches || !("IntersectionObserver" in window)) return;

    const observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            video.play().catch(function () {
              // ブラウザの自動再生ポリシーで拒否されても controls から再生できる。
            });
          } else {
            video.pause();
          }
        });
      },
      { threshold: 0.5 },
    );
    observer.observe(video);
  })();
</script>
