---
// ヒーロー (ファーストビュー)。#top はヘッダのロゴからのスクロール先。
import {
  PLAY_URL,
  REPO_URL,
  REPO_IS_PUBLIC,
  EXTERNAL_LINK_ATTRS,
  externalLinkLabel,
  withUtm,
} from "../consts";
import { Image } from "astro:assets";
import { existsSync } from "node:fs";
import gameScreenshot from "../assets/game-screenshot.png";

// プレイ動画 (#A)。public/hero-battle.{webm,mp4} と public/hero-poster.png が
// 用意されたら <video> を使い、未用意の間は従来の静止画にフォールバックする
// (存在しないファイルを参照して 404 や Lighthouse エラーを発生させないため)。
// #94/#95 で実アセットが揃い次第、public/ に上記 3 ファイルを置くだけで自動切り替わる。
const base = import.meta.env.BASE_URL;
const publicDir = new URL("../../public/", import.meta.url);
const hasHeroVideo =
  existsSync(new URL("hero-battle.webm", publicDir)) &&
  existsSync(new URL("hero-battle.mp4", publicDir)) &&
  existsSync(new URL("hero-poster.png", publicDir));
const withBase = (p: string) => `${base}/${p}`.replace(/\/+/g, "/");
---

<section
  id="top"
  aria-labelledby="hero-heading"
  class="mx-auto flex max-w-5xl flex-col items-start gap-6 px-6 pt-24 pb-16"
>
  <p class="eyebrow">programmable auto-battle</p>
  <h1 id="hero-heading" class="text-4xl font-bold tracking-tight sm:text-6xl">
    自分で組んだ AI で、<br />部隊を戦わせる。
  </h1>
  <p class="max-w-2xl text-lg text-slate-300">
    複数ユニットの AI を行動ルール UI
    またはテキストプログラムで設計し、自動戦闘を観察してログで分析する。
    軽戦車・重戦車・偵察ドローン・ミサイル車両、障害物、キャンペーン、非同期対戦まで広がった、
    観察とデバッグが中核のプログラマブル・オートバトル。
  </p>
  <div class="mt-2 flex flex-wrap gap-4">
    <a
      href={withUtm(PLAY_URL, "hero")}
      class="btn-primary"
      aria-label={externalLinkLabel("今すぐプレイ")}
      {...EXTERNAL_LINK_ATTRS}>今すぐプレイ</a
    >
    {
      REPO_IS_PUBLIC ? (
        <a
          href={REPO_URL}
          class="btn-ghost"
          aria-label={externalLinkLabel("GitHub を見る")}
          {...EXTERNAL_LINK_ATTRS}
        >
          GitHub を見る
        </a>
      ) : (
        <span class="btn-ghost-disabled" aria-disabled="true">
          GitHub（準備中）
        </span>
      )
    }
  </div>

  {
    hasHeroVideo ? (
      <figure
        aria-label="code-tactics のプレイ動画。ルールエディタで設定した AI に従い、複数の戦車が自動で接近・戦闘する様子"
        class="mt-4 w-full overflow-hidden rounded-xl border border-slate-800 shadow-2xl"
      >
        <video
          class="w-full"
          poster={withBase("hero-poster.png")}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          data-motion-optional
        >
          <source src={withBase("hero-battle.webm")} type="video/webm" />
          <source src={withBase("hero-battle.mp4")} type="video/mp4" />
        </video>
      </figure>
    ) : (
      <figure
        aria-label="code-tactics のゲーム画面。左に行動ルールエディタ、中央に 2 体の戦車が接近する戦場キャンバス、下にリアルタイム戦闘ログ"
        class="mt-4 w-full overflow-hidden rounded-xl border border-slate-800 shadow-2xl"
      >
        <Image
          src={gameScreenshot}
          alt="code-tactics のゲーム全体画面。右パネルの行動ルールエディタで AI ルールを設定し、中央キャンバスで 2 体の戦車（青・赤）が互いの射程に接近した場面"
          class="w-full"
          loading="eager"
        />
      </figure>
    )
  }
</section>

<script is:inline>
  // reduce-motion 時は自動再生を停止し poster 静止画で成立させる (WCAG 2.2.2)。
  (function () {
    const reduceMotion =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduceMotion) return;
    document
      .querySelectorAll("video[data-motion-optional]")
      .forEach(function (video) {
        video.removeAttribute("autoplay");
        video.pause();
      });
  })();
</script>
