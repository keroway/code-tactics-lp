---
// プログラム言語訴求セクション。
// 行動ルール UI とテキスト構文の相互変換を紹介し、「プログラマブル」の核を見せる。
// 構文は本体 docs/program-language.md を正典とし、実在する語のみ使用する。
---

<section id="program" data-animate class="scroll-mt-20">
  <p class="eyebrow">program language</p>
  <h2 class="mt-3 text-2xl font-bold sm:text-3xl">
    行動ルールでも、テキストでも。
  </h2>
  <p class="mt-4 max-w-2xl text-slate-300">
    行動ルール UI
    で並べたルールは、テキストの簡易プログラム言語に変換して編集できる。
    両者は相互に変換でき、どちらで書いても結果は変わらない。 GUI
    で大まかに組み、細かい条件はテキストで調整するといった使い方もできる。
  </p>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <!-- 行動ルール UI (疑似表示) -->
    <div
      class="overflow-hidden rounded-lg border border-slate-800 bg-slate-900/60"
    >
      <div
        class="flex items-center gap-2 border-b border-slate-800 px-4 py-2 font-mono text-xs text-slate-400"
      >
        <span class="size-2.5 rounded-full bg-rose-500/70" aria-hidden="true"
        ></span>
        <span class="size-2.5 rounded-full bg-amber-500/70" aria-hidden="true"
        ></span>
        <span class="size-2.5 rounded-full bg-emerald-500/70" aria-hidden="true"
        ></span>
        <span class="ml-2">gambits — player-tank</span>
      </div>
      <div class="p-4">
        <ol class="space-y-2 font-mono text-sm" aria-label="行動ルール一覧">
          {
            [
              {
                no: "#1",
                cond: "enemy_in_range and weapon_ready",
                action: "attack",
              },
              {
                no: "#2",
                cond: "hp_below(30)",
                action: "keep_distance(200)",
              },
              {
                no: "#3",
                cond: "enemy_in_range",
                action: "move_to weakest_enemy",
              },
              { no: "#4", cond: "always", action: "stop" },
            ].map((r, i) => (
              <li
                class="rule-row flex flex-wrap items-center gap-x-2 gap-y-1 rounded border border-slate-800 bg-slate-950/60 px-3 py-2"
                data-rule-index={i}
              >
                <span class="text-slate-500">{r.no}</span>
                <span class="text-amber-400">if</span>
                <span class="text-emerald-300">{r.cond}</span>
                <span class="text-amber-400">→</span>
                <span class="text-slate-100">{r.action}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <!-- テキスト構文 (対応するプログラム) -->
    <div
      class="overflow-hidden rounded-lg border border-slate-800 bg-slate-900/60"
    >
      <div
        class="flex items-center gap-2 border-b border-slate-800 px-4 py-2 font-mono text-xs text-slate-400"
      >
        <span class="size-2.5 rounded-full bg-rose-500/70" aria-hidden="true"
        ></span>
        <span class="size-2.5 rounded-full bg-amber-500/70" aria-hidden="true"
        ></span>
        <span class="size-2.5 rounded-full bg-emerald-500/70" aria-hidden="true"
        ></span>
        <span class="ml-2">program — player-tank.ct</span>
      </div>
      <pre
        class="overflow-x-auto p-4 font-mono text-sm leading-relaxed"
        aria-label="行動ルールと等価なプログラムテキスト"><code><span class="text-slate-500"># 相互変換後のテキスト表現</span>
<span class="rule-row" data-rule-index="0"><span class="text-amber-400">rule</span> <span class="text-emerald-300">"attack-first"</span>
  <span class="text-amber-400">when</span>   enemy_in_range <span class="text-slate-400">and</span> weapon_ready
  <span class="text-amber-400">target</span> nearest_enemy
  <span class="text-amber-400">do</span>     attack</span>

<span class="rule-row" data-rule-index="1"><span class="text-amber-400">rule</span> <span class="text-emerald-300">"retreat-low-hp"</span>
  <span class="text-amber-400">when</span>   hp_below(30)
  <span class="text-amber-400">target</span> nearest_enemy
  <span class="text-amber-400">do</span>     keep_distance(200)</span>

<span class="rule-row" data-rule-index="2"><span class="text-amber-400">rule</span> <span class="text-emerald-300">"approach-weakest"</span>
  <span class="text-amber-400">when</span>   enemy_in_range
  <span class="text-amber-400">target</span> weakest_enemy
  <span class="text-amber-400">do</span>     move_to</span>

<span class="rule-row" data-rule-index="3"><span class="text-amber-400">rule</span> <span class="text-emerald-300">"fallback"</span>
  <span class="text-amber-400">when</span>   always
  <span class="text-amber-400">target</span> self
  <span class="text-amber-400">do</span>     stop</span></code></pre>
    </div>
  </div>

  <p class="mt-4 font-mono text-xs text-slate-500">
    ※ 行動ルール UI
    とテキストは双方向に変換できる。構文は実際のゲームのものを掲載。
  </p>
</section>

<script is:inline>
  // ルール評価ハイライト (#B-1)。IntersectionObserver 可用かつ reduced-motion でない時のみ、
  // #program が画面内にある間、左右の対応するルール行を順にハイライトする。
  // 非対応・ JS 無効時は何もしない (静的表示のまま)。
  (function () {
    const reduceMotion =
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion || !("IntersectionObserver" in window)) return;

    const section = document.getElementById("program");
    if (!section) return;
    const rows = Array.prototype.slice.call(
      section.querySelectorAll("[data-rule-index]"),
    );
    if (rows.length === 0) return;

    let timer = null;
    let active = 0;

    function highlight(i) {
      rows.forEach(function (el) {
        el.classList.toggle(
          "is-active",
          el.getAttribute("data-rule-index") === String(i),
        );
      });
    }

    function start() {
      if (timer) return;
      highlight(active);
      timer = window.setInterval(function () {
        const max =
          Number(rows[rows.length - 1].getAttribute("data-rule-index")) + 1;
        active = (active + 1) % max;
        highlight(active);
      }, 1600);
    }

    function stop() {
      if (!timer) return;
      window.clearInterval(timer);
      timer = null;
      rows.forEach(function (el) {
        el.classList.remove("is-active");
      });
    }

    const io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            start();
          } else {
            stop();
          }
        });
      },
      { threshold: 0.3 },
    );
    io.observe(section);
  })();
</script>
