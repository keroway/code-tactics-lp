# dependencies
node_modules/

# build output (フレームワーク確定後に調整)
dist/
build/
.output/
.astro/
.svelte-kit/
.next/

# env
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.vscode/
.idea/

# agent tooling (ローカルの Claude Code / Pi 作業ディレクトリ)
# .claude/ 配下は個人ローカル設定 (settings.local.json, worktrees/ 等) を既定で除外しつつ、
# 共有設定 (settings.json, hooks/, README.md) だけコミット対象にする
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/README.md
.pi/remote-pi/
.pi/todos/
# Codex CLI の Stop hook 設定。hooks.json が絶対パスを含む個人ローカル層で、
# 共有すると他の環境で壊れる (keroway/agent-assets#186)
.codex/

# Lighthouse CI のローカル出力
.lighthouseci/

# CI（Ubuntu）で生成するアセット。ローカルと CI でバイナリが異なるため Git 非管理。
public/og.png
public/apple-touch-icon.png

# Codex CLI / agent-assets symlink (~/.agents) / pi のローカル生成物・個人状態。
# いずれも絶対パスや個人環境固有の値を含みうる個人ローカル層で、
# 共有すると他の環境で壊れる (keroway/agent-assets#186)
.agents/
.pi/
