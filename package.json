{
  "name": "code-tactics-lp",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome ci .",
    "format": "biome check --write . && prettier --write \"**/*.{astro,md}\"",
    "format:check": "prettier --check \"**/*.{astro,md}\"",
    "check": "pnpm run lint && pnpm run format:check && astro check",
    "postinstall": "lefthook install",
    "og": "node scripts/generate-og.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "lhci": "lhci autorun",
    "smoke:a11y": "node scripts/smoke-a11y.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.5",
    "@lhci/cli": "^0.15.1",
    "lefthook": "^2.1.10",
    "playwright": "^1.61.1",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  }
}
