{
  "name": "code-tactics-lp",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome ci .",
    "format": "biome check --write . && prettier --write \"**/*.{astro,md}\"",
    "format:check": "prettier --check \"**/*.{astro,md}\"",
    "check": "pnpm run lint && pnpm run format:check && astro check && pnpm run test",
    "postinstall": "lefthook install",
    "og": "node scripts/generate-og.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "lhci": "lhci autorun",
    "smoke:a11y": "node scripts/smoke-a11y.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check:repo-gate": "node scripts/check-repo-gate.mjs",
    "check:hero-video": "node scripts/check-hero-video.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:beacon-gate": "node scripts/check-beacon-gate.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.5",
    "@lhci/cli": "^0.15.1",
    "lefthook": "^2.1.10",
    "playwright": "^1.61.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
