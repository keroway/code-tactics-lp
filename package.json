{
  "name": "code-tactics-lp",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome ci .",
    "format": "biome check --write . && prettier --write \"**/*.{astro,md}\"",
    "format:check": "prettier --check \"**/*.{astro,md}\"",
    "check": "pnpm run lint && pnpm run format:check && astro check",
    "postinstall": "lefthook install",
    "og": "node scripts/generate-og.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "lhci": "lhci autorun",
    "smoke:a11y": "node scripts/smoke-a11y.mjs",
    "check:repo-gate": "node scripts/check-repo-gate.mjs",
    "check:hero-video": "node scripts/check-hero-video.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.5",
    "@lhci/cli": "^0.15.1",
    "lefthook": "^2.1.10",
    "playwright": "^1.61.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3"
  }
